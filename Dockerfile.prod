# ─── مرحله build ────────────────────────────────────────────
FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# متغیرهای Vite فقط زمان build خونده می‌شن (import.meta.env) — طبق تجربه‌ی nivo-ai-frontend
# (Dockerfile.prod آنجا)، دارکوب مقدار پنل «Environment Variables» را به build-arg نمی‌رساند،
# پس مقدار واقعی پروداکشن همین‌جا هاردکد شده، نه صرفاً یک default قابل override.
ARG VITE_API_URL=https://api.nivoai.ir/api/v1
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# ─── مرحله serve ────────────────────────────────────────────
FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.spa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
